# URL du live CNews sur Dailymotion (ou ID video Dailymotion)
CNEWS_DAILYMOTION_ID=x3b68jn

# Cle API gratuite Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=

# Modele Gemini gratuit utilise pour le bilan toutes les 5 minutes
GEMINI_MODEL=gemini-3.5-flash

# Intervalle entre deux analyses Gemini (en secondes, 300 = 5 minutes)
ANALYSIS_INTERVAL_SECONDS=300

# URL Web App de votre Google Apps Script (pour envoyer vers Google Sheets)
GOOGLE_APPS_SCRIPT_URL=

# Secret partage optionnel verifie par Google Apps Script
SHEETS_WEBHOOK_SECRET=

# Fuseau horaire d'affichage et de regroupement journalier
TIMEZONE=Europe/Paris
